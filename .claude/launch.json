{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@kortex/site",
        "exec",
        "astro",
        "preview",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "run",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT --directory dist/run"
      ],
      "port": 4330,
      "autoPort": true
    },
    {
      "name": "app",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT --directory dist/apps/${KORTEX_APP:-apps.flow}"
      ],
      "port": 4340,
      "autoPort": true
    },
    {
      "name": "app-mind",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT --directory dist/apps/apps.mind"
      ],
      "port": 4351,
      "autoPort": true
    },
    {
      "name": "app-store",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT --directory dist/apps/apps.store"
      ],
      "port": 4352,
      "autoPort": true
    },
    {
      "name": "app-hub",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server $PORT --directory dist/apps/apps.hub"
      ],
      "port": 4353,
      "autoPort": true
    }
  ]
}