---
import Base from '../layouts/Base.astro';
---
<Base title="404 — Kortex" description="Page introuvable — Page not found" lang="fr" noindex>
  <section class="nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Page introuvable</h1>
    <p lang="en" class="k-muted">Page not found</p>
    <p class="nf-links"><a class="k-btn" href="/">Retour à l'accueil</a> <a class="k-btn" data-variant="ghost" href="/en" lang="en">Back to home</a></p>
  </section>
<style>
  .nf { display: grid; justify-items: center; gap: var(--k-space-3); max-width: 560px; margin: var(--k-space-8) auto 0; text-align: center; }
  .nf h1, .nf .k-muted { margin: 0; }
  .nf h1 { font-size: var(--k-type-scale-4); }
  .nf-links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--k-space-2); margin-top: var(--k-space-4); }
  .nf-code { margin: 0; font-family: var(--k-type-display); font-size: clamp(5rem, 16vw, 9rem); font-weight: var(--k-type-weight-display); letter-spacing: var(--k-type-tracking-display); line-height: 1; color: var(--k-surface-3); }
</style>
</Base>
