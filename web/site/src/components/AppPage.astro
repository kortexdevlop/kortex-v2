---
import Base from '../layouts/Base.astro';
import { apps, type AppInfo } from '../lib/apps';
import { prefix, type Lang } from '../lib/data';
const { lang, app } = Astro.props as { lang: Lang; app?: AppInfo };
const fr = lang === 'fr';
const home = fr ? '/applications' : '/en/apps';
const description = app?.description[lang] ?? (fr ? 'Découvrez les applications Kortex, leurs fonctions disponibles et les prochaines étapes.' : 'Explore Kortex applications, available features and upcoming work.');
---
<Base lang={lang} title={app ? `${app.name} — Kortex` : (fr ? 'Applications — Kortex' : 'Apps — Kortex')}
  description={description} noindex={!!app && !app.available}
  alt={app ? {fr:`/${app.id}`,en:`/en/${app.id}`} : {fr:'/applications',en:'/en/apps'}}>
  {app ? <>
    <nav aria-label={fr ? 'Fil d’Ariane' : 'Breadcrumb'}><a href={home}>{fr ? 'Applications' : 'Apps'}</a> / <span>{app.name}</span></nav>
    <section class="app-hero">
      <p class="k-muted">{app.name}</p><h1>{app.title[lang]}</h1>
      <span class="badge">{app.status[lang]}</span><p>{description}</p>
      {'launchUrl' in app ? <a class="k-btn" href={`${app.launchUrl}${fr ? '/' : '/en/'}`}>{fr ? 'Ouvrir l’application' : 'Open app'}</a> : app.id === 'seek' ? <button class="k-btn" type="button" data-seek-open>{fr ? 'Ouvrir la recherche' : 'Open search'}</button>
        : app.id === 'store' ? <a class="k-btn" href={fr ? '/telecharger' : '/en/download'}>{fr ? 'Voir les options de téléchargement' : 'View download options'}</a>
        : app.id === 'hub' ? <a class="k-btn" href={fr ? '/compte' : '/en/account'}>{fr ? 'Voir la page Compte' : 'View the Account page'}</a>
        : <a class="k-btn" href={fr ? '/outils' : '/en/tools'}>{fr ? 'Explorer les outils actuels' : 'Explore current tools'}</a>}
    </section>
    <section class="k-card k-stack"><h2>{app.available ? (fr ? 'Ce qui existe aujourd’hui' : 'What exists today') : (fr ? 'Fonctions prévues' : 'Planned features')}</h2>
      <ul>{app.features[lang].map(feature => <li>{feature}</li>)}</ul>
      <p class="k-muted">{app.next[lang]}</p>
    </section>
    <section class="app-related"><h2>{fr ? 'Les autres applications' : 'Other apps'}</h2>
      <div class="app-links">{apps.filter(other => other.id !== app.id).map(other => <a class="k-btn" data-variant="ghost" href={`${prefix(lang)}/${other.id}`}>{other.name}</a>)}</div>
    </section>
  </> : <>
    <section class="app-hero"><h1>{fr ? 'Les applications Kortex' : 'Kortex apps'}</h1><p>{description}</p></section>
    <div class="grid">{apps.map(item => <a class="k-card k-stack app-card" href={`${prefix(lang)}/${item.id}`}>
      <span class="badge">{item.status[lang]}</span><h2>{item.name}</h2><p>{item.title[lang]}</p><span class="k-muted">{fr ? 'Découvrir' : 'Explore'} →</span>
    </a>)}</div>
    <section class="app-related"><h2>{fr ? 'Un socle commun, des usages complémentaires' : 'A shared foundation for different needs'}</h2>
      <p>{fr ? 'Les applications utiliseront les mêmes contrats et moteurs que les outils indépendants. Les traitements de fichiers restent locaux ; tout recours à l’IA nécessite votre consentement.' : 'Apps will use the same contracts and engines as standalone tools. File processing stays local; any use of AI requires your consent.'}</p>
    </section>
  </>}
</Base>
<style>
  .app-hero { max-width: 760px; padding-block: var(--k-space-7); }
  .app-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.12; }
  .app-hero p { line-height: 1.7; }
  .app-card { color: inherit; text-decoration: none; }
  .app-card h2, .app-card p { margin: 0; }
  .app-card .badge { justify-self: start; margin: 0; }
  .app-related { margin-top: var(--k-space-8); }
  .app-links { display: flex; flex-wrap: wrap; gap: var(--k-space-2); }
  li { margin-block: var(--k-space-2); }
</style>
