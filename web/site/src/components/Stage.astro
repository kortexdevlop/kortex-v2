---
// The "Stage": a floating window that hosts a tool in an iframe served from the run origin.
import type { Lang } from '../lib/data';
interface Props { toolId: string; name: string; lang: Lang; variantId?: string; label: string }
const { toolId, name, lang, variantId, label } = Astro.props;
const runOrigin = (import.meta.env.PUBLIC_RUN_ORIGIN ?? 'https://run.kortex.site').replace(/\/$/, '');
const query = new URLSearchParams({ lang, ...(variantId ? { variant: variantId } : {}) }).toString();
const src = `${runOrigin}/${toolId}/?${query}`;
const t = lang === 'fr'
  ? { close: 'Fermer', full: 'Plein écran', drop: 'Déposez vos fichiers pour ouvrir l’outil', loading: 'Chargement de l’outil…' }
  : { close: 'Close', full: 'Full screen', drop: 'Drop your files to open the tool', loading: 'Loading the tool…' };
const runHost = new URL(src).origin;
---
<link rel="preconnect" href={runHost} />
<button class="k-btn stage-open" type="button" data-stage-open data-src={src}>{label}</button>
<div class="stage-drop" data-stage-drop hidden>{t.drop}</div>
<div class="stage" data-stage hidden>
  <div class="stage-backdrop" data-stage-close></div>
  <section class="stage-window" role="dialog" aria-modal="true" aria-label={name}>
    <header class="stage-bar">
      <strong>{name}</strong>
      <span class="stage-actions">
        <button class="k-btn" data-variant="ghost" type="button" data-stage-full>{t.full}</button>
        <button class="k-btn" data-variant="ghost" type="button" data-stage-close>{t.close}</button>
      </span>
    </header>
    <div class="stage-body">
      <div class="stage-loading" role="status" data-stage-loading><span class="stage-spinner" aria-hidden="true"></span><span>{t.loading}</span></div>
      <iframe title={name} allow="clipboard-write" referrerpolicy="origin"></iframe>
    </div>
  </section>
</div>
<style is:global>
  .stage { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; }
  .stage[hidden] { display: none; }
  .stage-backdrop { position: absolute; inset: 0; background: var(--k-overlay); -webkit-backdrop-filter: blur(var(--k-glass-blur-sm)); backdrop-filter: blur(var(--k-glass-blur-sm)); }
  .stage-window { position: relative; display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); width: min(94vw, 1120px); height: min(92vh, 840px); background: var(--k-bg); border: 1px solid var(--k-border); border-radius: var(--k-radius-panel); box-shadow: var(--k-shadow-5); overflow: hidden; view-transition-name: stage-window; animation: k-appear var(--k-motion-slower) var(--k-motion-out) both; }
  .stage-window[data-full] { width: 100vw; height: 100dvh; border-radius: 0; border: 0; }
  .stage-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--k-space-3); min-width: 0; min-height: 56px; padding: var(--k-space-1) var(--k-space-2) var(--k-space-1) var(--k-space-5); border-bottom: 1px solid var(--k-border);
    background: var(--k-glass); -webkit-backdrop-filter: blur(var(--k-glass-blur-md)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-md)) saturate(var(--k-glass-saturate)); }
  .stage-bar strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: var(--k-type-weight-strong); letter-spacing: var(--k-type-tracking-tight); }
  .stage-actions { display: flex; gap: var(--k-space-1); flex-shrink: 0; }
  .stage-actions .k-btn { background: transparent; border-color: transparent; color: var(--k-text-2); padding-inline: var(--k-space-4); }
  .stage-actions .k-btn:hover { background: var(--k-surface-2); color: var(--k-text); }
  .stage-body { position: relative; min-width: 0; min-height: 0; overflow: hidden; }
  .stage-window iframe { position: absolute; inset: 0; width: 1px; min-width: 100%; max-width: 100%; height: 100%; border: 0; background: var(--k-bg); }
  .stage-loading { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; justify-items: center; gap: var(--k-space-3); background: var(--k-bg); color: var(--k-text-2); font-size: var(--k-type-scale-sm);
    transition: opacity var(--k-motion-base) var(--k-motion-ease), visibility 0s linear var(--k-motion-base); }
  .stage-window[data-ready] .stage-loading { opacity: 0; visibility: hidden; }
  .stage-spinner { width: 28px; height: 28px; border-radius: var(--k-radius-round); border: 2.5px solid var(--k-surface-3); border-top-color: var(--k-text); animation: k-spin 0.8s linear infinite; }
  @keyframes k-spin { to { transform: rotate(360deg); } }
  @media (max-width: 640px) { .stage-window { width: 100vw; height: 100dvh; border-radius: 0; border: 0; padding-bottom: env(safe-area-inset-bottom); } .stage-bar { padding-top: max(var(--k-space-1), env(safe-area-inset-top)); padding-left: var(--k-space-4); } .stage-actions .k-btn { padding-inline: var(--k-space-3); } [data-stage-full] { display: none; } }
  .stage-drop { position: fixed; inset: var(--k-space-3); z-index: 60; display: grid; place-items: center; border: 2px dashed var(--k-accent); border-radius: var(--k-radius-panel); background: var(--k-overlay); -webkit-backdrop-filter: blur(var(--k-glass-blur-sm)); backdrop-filter: blur(var(--k-glass-blur-sm)); color: var(--k-text); font-size: var(--k-type-scale-2); font-weight: var(--k-type-weight-strong); pointer-events: none; }
  .stage-drop[hidden] { display: none; }
  .stage-open { min-height: 52px; padding-inline: var(--k-space-7); font-size: var(--k-type-scale-0); }
  .stage-open.vt { view-transition-name: stage-window; }
  ::view-transition-group(stage-window) { animation-duration: var(--k-motion-slower); animation-timing-function: var(--k-motion-out); }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) { .stage-backdrop, .stage-drop, .stage-bar { background: var(--k-surface); -webkit-backdrop-filter: none; backdrop-filter: none; } }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-stage]')!;
  const opener = document.querySelector<HTMLButtonElement>('[data-stage-open]')!;
  const dropHint = document.querySelector<HTMLElement>('[data-stage-drop]')!;
  const win = root.querySelector<HTMLElement>('.stage-window')!;
  const frame = root.querySelector('iframe')!;
  const runOrigin = new URL(opener.dataset.src!).origin;
  let loaded = false;
  let ready = false;
  let pendingFiles: File[] | null = null;

  // --- host <-> tool bus: only messages from our own iframe and its exact origin are trusted ---
  const post = (msg: object) => frame.contentWindow?.postMessage(msg, runOrigin);
  const theme = (): 'light' | 'dark' => {
    const forced = document.documentElement.dataset.theme;
    if (forced === 'light' || forced === 'dark') return forced;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const mode = (): string => { try { return localStorage.getItem('k-mode') || 'medium'; } catch { return 'medium'; } };
  const flush = () => {
    if (!ready) return;
    post({ type: 'kortex:init', theme: theme(), mode: mode() });
    if (pendingFiles) { post({ type: 'kortex:files', files: pendingFiles }); pendingFiles = null; }
  };
  addEventListener('message', (e) => {
    if (e.source !== frame.contentWindow || e.origin !== runOrigin || e.data?.type !== 'kortex:ready') return;
    ready = true;
    win.setAttribute('data-ready', '');
    flush();
  });
  const sync = () => post({ type: 'kortex:init', theme: theme(), mode: mode() });
  addEventListener('kortex:theme', sync);
  addEventListener('kortex:mode', sync);
  frame.addEventListener('load', () => { ready = false; win.removeAttribute('data-ready'); });

  const load = () => {
    if (loaded) return;
    loaded = true;
    frame.src = `${opener.dataset.src!}&mode=${mode()}`;
  };
  const swap = (fn: () => void) => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('startViewTransition' in document) || reduce) return fn();
    // A transition can be skipped (e.g. during the page's own navigation transition): fn still runs.
    const t = (document as any).startViewTransition(fn);
    for (const p of [t.ready, t.finished, t.updateCallbackDone]) p.catch(() => {});
  };
  const setUrl = (open: boolean) => {
    const u = new URL(location.href);
    if (open) u.searchParams.set('open', '1'); else u.searchParams.delete('open');
    history.replaceState(null, '', u);
  };
  const open = () => {
    load();
    opener.classList.add('vt');
    swap(() => {
      opener.classList.remove('vt');
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      root.querySelector<HTMLElement>('[data-stage-close]:not(.stage-backdrop)')?.focus();
    });
    setUrl(true);
  };
  const close = () => {
    swap(() => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      win.removeAttribute('data-full');
      opener.focus();
    });
    setUrl(false);
  };

  opener.addEventListener('click', open);
  // Preload the tool bundle as soon as the user shows intent.
  ['pointerenter', 'focus', 'touchstart'].forEach((e) => opener.addEventListener(e, load, { once: true, passive: true }));
  // Warm the tool up while the page is idle, so it is ready when opened (never on data saver or 2G).
  const net = (navigator as any).connection;
  const thrifty = net?.saveData === true || /(^|-)2g$/.test(net?.effectiveType ?? '');
  if (!thrifty) {
    const idle = (fn: () => void) => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 1200));
    const warm = () => idle(load);
    if (document.readyState === 'complete') warm(); else addEventListener('load', warm, { once: true });
  }
  root.querySelectorAll('[data-stage-close]').forEach((el) => el.addEventListener('click', close));
  root.querySelector('[data-stage-full]')!.addEventListener('click', () => win.toggleAttribute('data-full'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) close(); });

  // --- drop files anywhere on the page: open the tool and hand the files over ---
  const hasFiles = (e: DragEvent) => !!e.dataTransfer && [...e.dataTransfer.types].includes('Files');
  let depth = 0;
  addEventListener('dragenter', (e) => { if (!hasFiles(e) || !root.hidden) return; depth++; dropHint.hidden = false; });
  addEventListener('dragover', (e) => { if (hasFiles(e) && root.hidden) e.preventDefault(); });
  addEventListener('dragleave', (e) => { if (!hasFiles(e)) return; depth = Math.max(0, depth - 1); if (!depth) dropHint.hidden = true; });
  addEventListener('drop', (e) => {
    if (!hasFiles(e) || !root.hidden) return;
    e.preventDefault();
    depth = 0;
    dropHint.hidden = true;
    pendingFiles = [...(e.dataTransfer?.files ?? [])];
    open();
    flush();
  });

  if (new URLSearchParams(location.search).get('open') === '1') open();
</script>
