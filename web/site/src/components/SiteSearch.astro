---
import type { Lang } from '../lib/data';
const { lang } = Astro.props as { lang: Lang };
const t = lang === 'fr'
  ? { label: 'Rechercher un outil', placeholder: 'Que voulez-vous faire ? (ex. réduire le poids d’une photo)', empty: 'Aucun outil trouvé. Essayez un autre mot.', hint: 'Entrée pour ouvrir · Échap pour fermer', suggest: 'Suggestions' }
  : { label: 'Search tools', placeholder: 'What do you want to do? (e.g. make a photo smaller)', empty: 'No tool found. Try another word.', hint: 'Enter to open · Esc to close', suggest: 'Suggestions' };
---
<button class="seek-trigger" type="button" data-seek-open aria-label={t.label}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  <span class="seek-label">{t.label}</span>
  <kbd data-seek-kbd>⌘K</kbd>
</button>
<dialog class="seek" data-seek data-lang={lang} aria-label={t.label}>
  <div class="seek-box">
    <input class="k-input" type="search" data-seek-input placeholder={t.placeholder} autocomplete="off" spellcheck="false" aria-label={t.label} />
    <ul class="seek-list" role="listbox" data-seek-list></ul>
    <p class="seek-hint k-muted" data-seek-hint data-empty={t.empty} data-suggest={t.suggest}>{t.hint}</p>
  </div>
</dialog>
<style is:global>
  .seek-trigger { display: inline-flex; align-items: center; gap: var(--k-space-2); min-height: 44px; min-width: 44px; padding: 0 var(--k-space-2) 0 var(--k-space-3); border: 1px solid var(--k-glass-edge); border-radius: var(--k-radius-pill);
    background: var(--k-glass-strong); color: var(--k-text-2); font: inherit; cursor: pointer; box-shadow: var(--k-shadow-inset); transition: box-shadow var(--k-motion-base) var(--k-motion-ease), color var(--k-motion-base) var(--k-motion-ease); }
  .seek-trigger:hover { box-shadow: var(--k-shadow-inset), var(--k-shadow-2); color: var(--k-text); }
  .seek-trigger kbd { padding: 0 var(--k-space-2); border-radius: var(--k-radius-pill); background: var(--k-surface-2); line-height: 1.7; }
  @media (max-width: 767px) { .seek-label, .seek-trigger kbd { display: none; } .seek-trigger { justify-content: center; padding: 0; } }
  dialog.seek { width: min(640px, calc(100vw - 2 * var(--k-space-4))); margin: 12vh auto auto; padding: 0; border: 1px solid var(--k-glass-edge); border-radius: var(--k-radius-sheet);
    background: linear-gradient(180deg, var(--k-glass-highlight), transparent 20%), var(--k-glass-strong); color: var(--k-text); box-shadow: var(--k-shadow-inset), var(--k-shadow-5);
    -webkit-backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); }
  dialog.seek[open] { animation: k-appear var(--k-motion-slow) var(--k-motion-out) both; }
  dialog.seek::backdrop { background: var(--k-overlay); -webkit-backdrop-filter: blur(var(--k-glass-blur-sm)); backdrop-filter: blur(var(--k-glass-blur-sm)); }
  .seek-box { padding: var(--k-space-4); display: grid; gap: var(--k-space-3); }
  .seek-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--k-space-1); max-height: 50vh; overflow: auto; }
  .seek-item a { display: grid; grid-template-columns: 32px 1fr; gap: var(--k-space-3); align-items: center; min-height: 44px; padding: var(--k-space-3); border-radius: var(--k-radius-field); color: inherit; text-decoration: none; transition: background-color var(--k-motion-fast) var(--k-motion-ease); }
  .seek-item[aria-selected="true"] a, .seek-item a:hover { background: var(--k-glass-strong); box-shadow: var(--k-shadow-inset), var(--k-shadow-1); }
  .seek-item svg { width: 28px; height: 28px; color: var(--k-accent); }
  .seek-item small { display: block; color: var(--k-text-2); }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) { dialog.seek { background: var(--k-surface); -webkit-backdrop-filter: none; backdrop-filter: none; } }
  .seek-hint { margin: 0; font-size: var(--k-type-scale-sm); }
</style>
<script>
  import { search, type SeekEntry } from '../lib/site-search';

  const dlg = document.querySelector<HTMLDialogElement>('[data-seek]')!;
  const input = dlg.querySelector<HTMLInputElement>('[data-seek-input]')!;
  const list = dlg.querySelector<HTMLUListElement>('[data-seek-list]')!;
  const hint = dlg.querySelector<HTMLElement>('[data-seek-hint]')!;
  const lang = (dlg.dataset.lang === 'en' ? 'en' : 'fr') as 'fr' | 'en';
  const defaultHint = hint.textContent ?? '';
  let index: SeekEntry[] | null = null;
  let active = 0;
  let current: { path: string }[] = [];

  if (/Mac|iPhone|iPad/.test(navigator.platform)) { /* keeps ⌘K */ } else {
    document.querySelectorAll('[data-seek-kbd]').forEach((k) => (k.textContent = 'Ctrl K'));
  }

  const load = async () => {
    if (index) return index;
    try {
      const res = await fetch('/seek-index.json');
      index = ((await res.json()) as Record<string, SeekEntry[]>)[lang] ?? [];
    } catch { index = []; }
    return index;
  };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  const render = (items: { entry: SeekEntry; variant?: { name: string; path: string } }[], suggestions = false) => {
    current = items.map((r) => ({ path: r.variant?.path ?? r.entry.path }));
    active = 0;
    list.innerHTML = items.map((r, i) => {
      const label = r.variant ? r.variant.name : r.entry.name;
      const sub = r.variant ? r.entry.name : r.entry.tagline;
      return `<li class="seek-item" role="option" aria-selected="${i === 0}"><a href="${r.variant?.path ?? r.entry.path}?open=1"><span>${r.entry.glyph}</span><span><strong>${esc(label)}</strong><small>${esc(sub)}</small></span></a></li>`;
    }).join('');
    hint.textContent = items.length || suggestions ? defaultHint : hint.dataset.empty ?? '';
  };
  const run = async () => {
    const idx = await load();
    const q = input.value.trim();
    if (!q) return render([...idx].sort((a, b) => a.name.localeCompare(b.name)).slice(0, 6).map((entry) => ({ entry })), true);
    render(search(idx, q));
  };
  const select = (i: number) => {
    const items = list.querySelectorAll('.seek-item');
    if (!items.length) return;
    active = (i + items.length) % items.length;
    items.forEach((el, n) => el.setAttribute('aria-selected', String(n === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  };
  const open = () => { if (!dlg.open) dlg.showModal(); input.value = ''; void run(); input.focus(); };

  document.querySelectorAll('[data-seek-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('keydown', (e) => {
    const typing = /INPUT|TEXTAREA|SELECT/.test((e.target as HTMLElement)?.tagName ?? '');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing && !dlg.open)) { e.preventDefault(); open(); }
  });
  input.addEventListener('input', () => void run());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); const t = current[active]; if (t) location.href = `${t.path}?open=1`; }
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
