---
import Base from '../layouts/Base.astro';
import ToolCard from './ToolCard.astro';
import { tools, universes, byPriority, universePath, toolPath, prefix, type Lang } from '../lib/data';
import { apps } from '../lib/apps';
const { lang } = Astro.props as { lang: Lang };
const T = {
  fr: {
    title: 'Kortex — des outils gratuits, rapides et privés',
    h1a: 'Des outils gratuits.', h1b: 'Vos fichiers restent chez vous.',
    sub: 'Convertir, fusionner, calculer, sécuriser : tout s’exécute sur votre appareil, sans compte, sans envoi.',
    cta: 'Que voulez-vous faire ?', popular: 'Outils populaires', all: 'Tous les outils', allHref: '/outils',
    universes: 'Des univers pour tout faire', soon: 'Bientôt', tool: 'outil', toolsN: 'outils',
    privacyTitle: 'Privé par conception', privacySub: 'Pas une promesse : une architecture.',
    points: [
      ['Traitement local', 'Chaque outil tourne dans votre navigateur ou votre application. Il n’y a pas de serveur de fichiers.'],
      ['Aucun envoi', 'Vos documents, photos et mots de passe ne quittent jamais votre appareil.'],
      ['Hors ligne', 'Après un premier chargement, les outils fonctionnent sans connexion.'],
    ],
    device: 'Votre appareil', server: 'Serveur de fichiers', none: 'aucun',
    emptyTools: 'Les premiers outils arrivent bientôt.', try: 'Essayez',
    apps: 'Les applications', appsSub: 'Les mêmes moteurs, réunis pour chercher, organiser et automatiser.', appsAll: 'Toutes les applications', appsHref: '/applications',
  },
  en: {
    title: 'Kortex — free, fast, private tools',
    h1a: 'Free tools.', h1b: 'Your files stay with you.',
    sub: 'Convert, merge, calculate, secure: everything runs on your device, with no account and no upload.',
    cta: 'What do you want to do?', popular: 'Popular tools', all: 'All tools', allHref: '/en/tools',
    universes: 'A universe for everything', soon: 'Soon', tool: 'tool', toolsN: 'tools',
    privacyTitle: 'Private by design', privacySub: 'Not a promise: an architecture.',
    points: [
      ['Local processing', 'Every tool runs in your browser or app. There is no file server.'],
      ['Nothing uploaded', 'Your documents, photos and passwords never leave your device.'],
      ['Works offline', 'After a first load, tools work without a connection.'],
    ],
    device: 'Your device', server: 'File server', none: 'none',
    emptyTools: 'The first tools are coming soon.', try: 'Try',
    apps: 'The apps', appsSub: 'The same engines, brought together to find, arrange and automate.', appsAll: 'All apps', appsHref: '/en/apps',
  },
}[lang];
const popular = [...tools].filter((x) => x.tool.status !== 'draft').sort(byPriority).slice(0, 12);
// One tool per universe first, so the hero mosaic shows the breadth of the catalogue.
const ranked = [...tools].filter((x) => x.tool.status !== 'draft').sort(byPriority);
const firsts = universes.map((u) => ranked.find((x) => x.tool.universe === u.id)).filter((x): x is (typeof ranked)[number] => !!x);
const mosaic = [...firsts, ...ranked.filter((x) => !firsts.includes(x))].slice(0, 9);
const quick = popular.slice(0, 4);
const counts = (id: string) => tools.filter((x) => x.tool.universe === id).length;
const hueOf = (id: string) => universes.find((u) => u.id === id)?.hue ?? 250;
const files = ['facture.pdf', 'photo.heic', 'notes.md'];
---
<Base title={T.title} description={T.sub} lang={lang} alt={{ fr: '/', en: '/en' }}>
  <section class="home-hero">
    <div class="home-copy">
      <h1>{T.h1a}<br /><span class="home-h1-2">{T.h1b}</span></h1>
      <p class="lead">{T.sub}</p>
      <button class="home-search" type="button" data-seek-open>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
        <span>{T.cta}</span><kbd data-seek-kbd>⌘K</kbd>
      </button>
      {quick.length > 0 && (
        <p class="home-quick"><span class="k-muted">{T.try}</span>{quick.map((x) => <a href={toolPath(x, lang)}>{x.tool.name[lang]}</a>)}</p>
      )}
    </div>
    {mosaic.length > 0 && (
      <div class="home-mosaic" aria-hidden="true">
        {mosaic.map((x, i) => (
          <a class="home-tile" href={toolPath(x, lang)} tabindex="-1" style={`--hue:${hueOf(x.tool.universe)};--i:${i}`}>
            <img src={`/icons/${x.tool.id}.svg`} width="52" height="52" alt="" />
            <span>{x.tool.name[lang]}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section home-privacy reveal" aria-labelledby="privacy-title">
    <div class="section-head">
      <div><h2 id="privacy-title">{T.privacyTitle}</h2><p>{T.privacySub}</p></div>
    </div>
    <div class="bento">
      <article class="bento-card bento-local">
        <div class="bento-text"><h3>{T.points[0][0]}</h3><p>{T.points[0][1]}</p></div>
        <div class="device" aria-hidden="true">
          <div class="device-frame">
            <span class="device-label">{T.device}</span>
            <ul>{files.map((f) => <li><span class="device-file"></span>{f}</li>)}</ul>
          </div>
          <div class="device-link"></div>
          <div class="device-server"><span>{T.server}</span><strong>{T.none}</strong></div>
        </div>
      </article>
      <article class="bento-card bento-upload">
        <svg class="bento-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5M7.5 9.5 12 5l4.5 4.5" /><path d="M5 19.5h14" /><path d="M4 4l16 16" /></svg>
        <h3>{T.points[1][0]}</h3><p>{T.points[1][1]}</p>
      </article>
      <article class="bento-card bento-offline">
        <svg class="bento-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.8 16a5 5 0 0 1 6.4 0" /><circle cx="12" cy="19.2" r="1" fill="currentColor" /><path d="M3 3l18 18" /></svg>
        <h3>{T.points[2][0]}</h3><p>{T.points[2][1]}</p>
      </article>
      <a class="bento-card bento-count" href={T.allHref}>
        <span class="bento-num">{tools.length}</span>
        <span class="bento-cap">{T.toolsN}</span>
        <span class="more">{T.all}</span>
      </a>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="popular-title">
    <div class="section-head"><h2 id="popular-title">{T.popular}</h2><a class="more" href={T.allHref}>{T.all}</a></div>
    {popular.length === 0
      ? <p class="k-muted">{T.emptyTools}</p>
      : <div class="grid">{popular.map((x) => <ToolCard t={x} lang={lang} />)}</div>}
  </section>

  <section class="section reveal" aria-labelledby="universes-title">
    <div class="section-head"><h2 id="universes-title">{T.universes}</h2></div>
    <div class="universe-list">
      {universes.map((u) => (
        <a class="universe-row" style={`--hue:${u.hue}`} href={universePath(u, lang)} data-empty={counts(u.id) ? undefined : ''}>
          <span class="universe-dot" aria-hidden="true"></span>
          <strong>{u.name}</strong>
          <span class="k-muted">{counts(u.id) ? `${counts(u.id)} ${counts(u.id) > 1 ? T.toolsN : T.tool}` : T.soon}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section reveal" aria-labelledby="apps-title">
    <div class="section-head"><div><h2 id="apps-title">{T.apps}</h2><p>{T.appsSub}</p></div><a class="more" href={T.appsHref}>{T.appsAll}</a></div>
    <div class="home-apps">
      {apps.map((a) => (
        <a class="home-app" href={`${prefix(lang)}/${a.id}`}>
          <strong>{a.name}</strong>
          <span>{a.title[lang]}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style is:global>
  /* Hero: copy on the left, a live mosaic of the real tools on the right. */
  .home-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: var(--k-space-8); padding: var(--k-space-7) 0 var(--k-space-6); }
  .home-copy { display: grid; justify-items: start; gap: var(--k-space-5); }
  .home-hero h1 { margin: 0; font-size: clamp(2.5rem, 5.4vw, var(--k-type-scale-6)); line-height: 1.02; }
  .home-h1-2 { color: var(--k-text-2); }
  .home-search { display: inline-flex; align-items: center; gap: var(--k-space-3); width: min(480px, 100%); min-height: 56px; padding: 0 var(--k-space-3) 0 var(--k-space-5);
    border: 1px solid var(--k-border-strong); border-radius: var(--k-radius-pill); background: var(--k-surface); color: var(--k-text-2); font: inherit; cursor: pointer; box-shadow: var(--k-shadow-2);
    transition: border-color var(--k-motion-base) var(--k-motion-ease), box-shadow var(--k-motion-slow) var(--k-motion-out), color var(--k-motion-base) var(--k-motion-ease); }
  .home-search:hover { border-color: var(--k-text-2); color: var(--k-text); box-shadow: var(--k-shadow-3); }
  .home-search span { flex: 1; text-align: left; }
  .home-search kbd { padding: 0 var(--k-space-2); border-radius: var(--k-radius-control); border: 1px solid var(--k-border); background: var(--k-surface-2); line-height: 1.7; }
  .home-quick { display: flex; flex-wrap: wrap; align-items: center; gap: var(--k-space-1) var(--k-space-2); margin: 0; font-size: var(--k-type-scale-sm); }
  .home-quick span { margin-right: var(--k-space-1); }
  .home-quick a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--k-space-3); border-radius: var(--k-radius-pill); background: var(--k-surface-2); color: var(--k-text); text-decoration: none; font-weight: var(--k-type-weight-medium);
    transition: background-color var(--k-motion-base) var(--k-motion-ease); }
  .home-quick a:hover { background: var(--k-surface-3); }
  .home-mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--k-space-3); }
  .home-tile { --c: oklch(var(--k-hue-l) var(--k-hue-c) var(--hue)); display: grid; justify-items: center; align-content: center; gap: var(--k-space-2); aspect-ratio: 1; padding: var(--k-space-3);
    border: 1px solid var(--k-border); border-radius: var(--k-radius-card); color: var(--k-text-2); text-decoration: none; text-align: center; font-size: var(--k-type-scale-sm); line-height: 1.3;
    background: color-mix(in oklab, var(--c) 7%, var(--k-surface-2));
    animation: k-tile-in var(--k-motion-slower) var(--k-motion-out) both; animation-delay: calc(var(--i) * 40ms + 80ms); }
  .home-tile:nth-child(2n) { translate: 0 var(--k-space-4); }
  .home-tile span { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @keyframes k-tile-in { from { transform: translateY(12px) scale(0.96); } }
  @media (max-width: 959px) {
    .home-hero { grid-template-columns: 1fr; gap: var(--k-space-7); padding-top: var(--k-space-4); }
    .home-mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 520px; }
    .home-tile:nth-child(2n) { translate: none; }
    .home-tile:nth-child(n + 7) { display: none; }
  }
  @media (max-width: 479px) { .home-tile span { display: none; } .home-tile img { width: 36px; height: 36px; } }

  /* Privacy bento: one wide demonstration, two short facts, one catalogue count. */
  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: auto; gap: var(--k-space-4); }
  .bento-card { display: grid; align-content: start; gap: var(--k-space-2); padding: var(--k-space-6); border: 1px solid var(--k-border); border-radius: var(--k-radius-card); background: var(--k-surface); color: inherit; text-decoration: none; }
  .bento-card h3 { margin: 0; font-size: var(--k-type-scale-1); }
  .bento-card p { margin: 0; color: var(--k-text-2); line-height: 1.6; max-width: 46ch; }
  .bento-local { grid-column: span 4; grid-row: span 2; grid-template-rows: auto 1fr; gap: var(--k-space-6); background: var(--k-surface); }
  .bento-upload, .bento-offline { grid-column: span 2; min-height: 200px; }
  .bento-count { grid-column: span 6; grid-template-columns: auto 1fr auto; align-items: baseline; align-content: center; gap: var(--k-space-3); padding-block: var(--k-space-5);
    background: var(--k-ink); color: var(--k-ink-text); border-color: transparent; transition: transform var(--k-motion-slow) var(--k-motion-out); }
  .bento-count:hover { transform: translateY(-2px); }
  .bento-count .more { color: inherit; }
  .bento-num { font-family: var(--k-type-display); font-size: var(--k-type-scale-4); font-weight: var(--k-type-weight-strong); letter-spacing: var(--k-type-tracking-display); line-height: 1; font-variant-numeric: tabular-nums; }
  .bento-cap { font-size: var(--k-type-scale-1); font-weight: var(--k-type-weight-medium); opacity: 0.8; }
  .bento-glyph { width: 28px; height: 28px; margin-bottom: var(--k-space-3); fill: none; stroke: var(--k-text); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  /* The local-processing diagram: files inside the device, nothing on the server side. */
  .device { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(48px, 0.6fr) minmax(0, 1fr); align-items: center; align-self: end; }
  .device-frame { display: grid; gap: var(--k-space-3); padding: var(--k-space-4); border-radius: var(--k-radius-field); background: var(--k-surface-2); }
  .device-label { font-size: var(--k-type-scale-sm); font-weight: var(--k-type-weight-strong); }
  .device ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--k-space-2); }
  .device li { display: flex; align-items: center; gap: var(--k-space-2); min-height: 36px; padding: 0 var(--k-space-3); border-radius: var(--k-radius-control); background: var(--k-surface); font-family: var(--k-type-mono); font-size: var(--k-type-scale-sm); }
  .device-file { width: 10px; height: 12px; background: var(--k-accent); opacity: 0.85; }
  .device-link { height: 0; border-top: 1.5px dashed var(--k-border-strong); position: relative; }
  .device-link::after { content: ""; position: absolute; left: 50%; top: -9px; width: 16px; height: 16px; margin-left: -8px; border-radius: var(--k-radius-round); background: var(--k-surface); box-shadow: var(--k-shadow-hairline);
    background-image: linear-gradient(45deg, transparent 45%, var(--k-danger) 45%, var(--k-danger) 55%, transparent 55%), linear-gradient(-45deg, transparent 45%, var(--k-danger) 45%, var(--k-danger) 55%, transparent 55%); }
  .device-server { display: grid; gap: var(--k-space-1); justify-items: center; padding: var(--k-space-4); border: 1.5px dashed var(--k-border-strong); border-radius: var(--k-radius-field); text-align: center; font-size: var(--k-type-scale-sm); color: var(--k-text-2); }
  .device-server strong { color: var(--k-text); font-size: var(--k-type-scale-1); }
  @media (max-width: 899px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento-local, .bento-count { grid-column: span 2; grid-row: auto; }
    .bento-upload, .bento-offline { grid-column: span 1; }
  }
  @media (max-width: 599px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .bento-local, .bento-count, .bento-upload, .bento-offline { grid-column: auto; }
    .bento-card { padding: var(--k-space-5); }
    .device { grid-template-columns: 1fr; gap: var(--k-space-4); }
    .device-link { display: none; }
    .bento-count { grid-template-columns: auto 1fr; }
    .bento-count .more { grid-column: 1 / -1; }
  }

  /* Universes: a compact index, not a wall of cards. */
  .universe-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); border-top: 1px solid var(--k-border); column-gap: var(--k-space-6); }
  .universe-row { --c: oklch(var(--k-hue-l) var(--k-hue-c) var(--hue)); display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--k-space-3); min-height: 60px; border-bottom: 1px solid var(--k-border); color: inherit; text-decoration: none;
    transition: padding var(--k-motion-slow) var(--k-motion-out); }
  .universe-row:hover { padding-left: var(--k-space-2); }
  .universe-row strong { font-weight: var(--k-type-weight-medium); }
  .universe-row .k-muted { font-size: var(--k-type-scale-sm); font-variant-numeric: tabular-nums; }
  .universe-row[data-empty] strong { color: var(--k-text-2); }
  .universe-dot { width: 10px; height: 10px; border-radius: var(--k-radius-round); background: var(--c); outline: 4px solid color-mix(in oklab, var(--c) 18%, transparent); }

  /* Apps strip. */
  .home-apps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--k-space-4); }
  .home-app { display: grid; gap: var(--k-space-1); align-content: start; min-height: 120px; padding: var(--k-space-5); border-radius: var(--k-radius-card); background: var(--k-surface-2); color: inherit; text-decoration: none;
    transition: background-color var(--k-motion-base) var(--k-motion-ease); }
  .home-app:hover { background: var(--k-surface-3); }
  .home-app strong { font-size: var(--k-type-scale-1); font-weight: var(--k-type-weight-strong); }
  .home-app span { color: var(--k-text-2); line-height: 1.5; }
  @media (max-width: 899px) { .home-apps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 479px) { .home-apps { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .home-tile { animation: none; } }
</style>
