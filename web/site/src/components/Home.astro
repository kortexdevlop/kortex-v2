---
import Base from '../layouts/Base.astro';
import ToolCard from './ToolCard.astro';
import { tools, universes, byPriority, universePath, type Lang } from '../lib/data';
const { lang } = Astro.props as { lang: Lang };
const T = {
  fr: {
    title: 'Kortex — des outils gratuits, rapides et privés',
    h1a: 'Des outils gratuits.', h1b: 'Vos fichiers restent chez vous.',
    sub: 'Convertir, fusionner, calculer, sécuriser : tout s’exécute sur votre appareil, sans compte, sans envoi.',
    cta: 'Que voulez-vous faire ?', popular: 'Outils populaires', all: 'Tous les outils', allHref: '/outils',
    universes: 'Des univers pour tout faire', soon: 'Bientôt', tool: 'outil', toolsN: 'outils',
    privacyTitle: 'Privé par conception', privacySub: 'Pas une promesse : une architecture.',
    points: [
      ['Traitement local', 'Chaque outil tourne dans votre navigateur ou votre application. Il n’y a pas de serveur de fichiers.'],
      ['Aucun envoi', 'Vos documents, photos et mots de passe ne quittent jamais votre appareil.'],
      ['Hors ligne', 'Après un premier chargement, les outils fonctionnent sans connexion.'],
    ],
    emptyTools: 'Les premiers outils arrivent bientôt.',
  },
  en: {
    title: 'Kortex — free, fast, private tools',
    h1a: 'Free tools.', h1b: 'Your files stay with you.',
    sub: 'Convert, merge, calculate, secure: everything runs on your device, with no account and no upload.',
    cta: 'What do you want to do?', popular: 'Popular tools', all: 'All tools', allHref: '/en/tools',
    universes: 'A universe for everything', soon: 'Soon', tool: 'tool', toolsN: 'tools',
    privacyTitle: 'Private by design', privacySub: 'Not a promise: an architecture.',
    points: [
      ['Local processing', 'Every tool runs in your browser or app. There is no file server.'],
      ['Nothing uploaded', 'Your documents, photos and passwords never leave your device.'],
      ['Works offline', 'After a first load, tools work without a connection.'],
    ],
    emptyTools: 'The first tools are coming soon.',
  },
}[lang];
const popular = [...tools].filter((x) => x.tool.status !== 'draft').sort(byPriority).slice(0, 12);
const counts = (id: string) => tools.filter((x) => x.tool.universe === id).length;
---
<Base title={T.title} description={T.sub} lang={lang} alt={{ fr: '/', en: '/en' }}>
  <section class="hero home-hero" data-glow>
    <div class="home-stage" aria-hidden="true">
      <div class="home-plane home-plane-a k-glass"><span></span><span></span><span></span></div>
      <div class="home-plane home-plane-b k-glass"><svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.5" /><circle cx="18" cy="18" r="15.5" pathLength="100" /></svg></div>
      <div class="home-plane home-plane-c k-glass"><svg viewBox="0 0 120 40" preserveAspectRatio="none"><path d="M0 32 C 18 30, 26 12, 44 18 S 72 34, 86 16 S 110 6, 120 8" /></svg></div>
    </div>
    <svg class="home-mark" width="72" height="72" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path pathLength="1" d="M22 13V51M22 33C30 33 37 28 43 15C46 25 40 32 33 36C41 38 46 44 47 51" />
    </svg>
    <h1>{T.h1a}<br /><span class="home-grad">{T.h1b}</span></h1>
    <p class="home-sub">{T.sub}</p>
    <button class="home-search" type="button" data-seek-open>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      <span>{T.cta}</span><kbd data-seek-kbd>⌘K</kbd>
    </button>
  </section>

  <section class="reveal home-section">
    <div class="home-head"><h2>{T.popular}</h2><a href={T.allHref}>{T.all} →</a></div>
    {popular.length === 0
      ? <p class="k-muted">{T.emptyTools}</p>
      : <div class="grid">{popular.map((x) => <ToolCard t={x} lang={lang} />)}</div>}
  </section>

  <section class="reveal home-section">
    <h2>{T.universes}</h2>
    <div class="grid home-universes">
      {universes.map((u) => (
        <a class="k-card home-universe" style={`--hue:${u.hue}`} href={universePath(u, lang)} data-tilt>
          <span class="home-dot" aria-hidden="true"></span>
          <strong>{u.name}</strong>
          <span class="k-muted">{counts(u.id) ? `${counts(u.id)} ${counts(u.id) > 1 ? T.toolsN : T.tool}` : T.soon}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section home-privacy">
    <div class="home-pin">
      <h2>{T.privacyTitle}</h2>
      <p class="k-muted">{T.privacySub}</p>
    </div>
    <div class="home-points">{T.points.map(([h, p], i) => <div class="k-card reveal"><span class="home-num" aria-hidden="true">{`0${i + 1}`}</span><strong>{h}</strong><p class="k-muted">{p}</p></div>)}</div>
  </section>
</Base>

<style is:global>
  .home-hero { position: relative; text-align: center; padding: var(--k-space-8) 0 var(--k-space-7); isolation: isolate; perspective: 1200px; }
  /* Floating glass planes in depth behind the headline; they follow the pointer (--gx/--gy) and drift slowly. */
  .home-stage { position: absolute; inset: 0; z-index: -1; pointer-events: none; transform-style: preserve-3d;
    transform: rotateX(calc((var(--gy, 50) - 50) * -0.06deg)) rotateY(calc((var(--gx, 50) - 50) * 0.08deg)); transition: transform var(--k-motion-slower) var(--k-motion-out); }
  .home-plane { position: absolute; display: grid; place-items: center; border-radius: var(--k-radius-card); animation: k-float 9s var(--k-motion-ease) infinite alternate; }
  .home-plane-a { left: 0; top: 14%; width: 180px; height: 128px; padding: var(--k-space-4); gap: var(--k-space-2); place-items: stretch; align-content: center; transform: translateZ(-60px) rotate(-8deg); }
  .home-plane-a span { height: 8px; border-radius: var(--k-radius-pill); background: var(--k-surface-2); }
  .home-plane-a span:first-child { width: 60%; background: var(--k-accent); opacity: 0.7; }
  .home-plane-b { right: 2%; top: 6%; width: 132px; height: 132px; border-radius: var(--k-radius-panel); transform: translateZ(-20px) rotate(6deg); animation-delay: -3s; }
  .home-plane-b svg { width: 72px; height: 72px; transform: rotate(-90deg); }
  .home-plane-b circle { fill: none; stroke-width: 3; stroke: var(--k-surface-2); }
  .home-plane-b circle + circle { stroke: var(--k-accent-2); stroke-linecap: round; stroke-dasharray: 68 100; }
  .home-plane-c { right: 8%; bottom: 4%; width: 200px; height: 88px; padding: var(--k-space-3) var(--k-space-4); transform: translateZ(-100px) rotate(-4deg); animation-delay: -6s; }
  .home-plane-c svg { width: 100%; height: 100%; }
  .home-plane-c path { fill: none; stroke: var(--k-accent); stroke-width: 2.5; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  @keyframes k-float { from { translate: 0 0; } to { translate: 0 -14px; } }
  @media (max-width: 599px) { .home-hero { padding-top: var(--k-space-6); } }
  @media (max-width: 899px) { .home-plane-a, .home-plane-c { display: none; } .home-plane-b { width: 88px; height: 88px; right: -12px; top: 0; } .home-plane-b svg { width: 48px; height: 48px; } }
  .home-mark { color: var(--k-accent); margin-bottom: var(--k-space-5); filter: drop-shadow(0 6px 18px var(--k-glow)); }
  .home-mark path { stroke-dasharray: 1; stroke-dashoffset: 1; animation: k-draw 1.4s var(--k-motion-ease) 0.15s forwards; }
  @keyframes k-draw { to { stroke-dashoffset: 0; } }
  .home-hero h1 { font-weight: var(--k-type-weight-strong); }
  .home-grad { background: linear-gradient(90deg, var(--k-accent), var(--k-accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .home-sub { max-width: 34em; margin: 0 auto var(--k-space-6); color: var(--k-text-2); font-size: var(--k-type-scale-1); line-height: 1.5; }
  .home-search { display: inline-flex; align-items: center; gap: var(--k-space-3); min-height: 56px; padding: 0 var(--k-space-3) 0 var(--k-space-5); width: min(560px, 100%); border: 1px solid var(--k-glass-edge); border-radius: var(--k-radius-pill);
    background: linear-gradient(180deg, var(--k-glass-highlight), transparent 50%), var(--k-glass-strong); color: var(--k-text-2); font: inherit; font-size: 1.05rem; cursor: pointer; box-shadow: var(--k-shadow-inset), var(--k-shadow-3);
    -webkit-backdrop-filter: blur(var(--k-glass-blur-md)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-md)) saturate(var(--k-glass-saturate));
    transition: transform var(--k-motion-slow) var(--k-motion-out), box-shadow var(--k-motion-base) var(--k-motion-ease), color var(--k-motion-base) var(--k-motion-ease); }
  .home-search:hover { transform: translateY(-2px); box-shadow: var(--k-shadow-inset), var(--k-shadow-glow); color: var(--k-text); }
  .home-search span { flex: 1; text-align: left; }
  .home-search kbd { padding: 0 var(--k-space-2); border-radius: var(--k-radius-pill); background: var(--k-surface-2); line-height: 1.8; }
  .home-section { margin-top: var(--k-space-9); }
  .home-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--k-space-4); flex-wrap: wrap; }
  .home-head a { display: inline-flex; align-items: center; min-height: 44px; color: var(--k-accent); text-decoration: none; font-weight: var(--k-type-weight-medium); }
  .home-universes { grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }
  .home-universe { display: grid; gap: var(--k-space-1); }
  .home-dot { --c: oklch(var(--k-hue-l) var(--k-hue-c) var(--hue)); width: 12px; height: 12px; margin-bottom: var(--k-space-2); border-radius: var(--k-radius-round); background: var(--c); outline: 4px solid color-mix(in oklab, var(--c) 22%, transparent); }
  /* Pinned section: the heading stays while the three points scroll past (wide screens). */
  .home-privacy { display: grid; gap: var(--k-space-5); }
  .home-points { display: grid; gap: var(--k-space-4); }
  .home-points .k-card { display: grid; gap: var(--k-space-2); }
  .home-points p { margin: 0; }
  .home-num { font-size: var(--k-type-scale-sm); font-weight: var(--k-type-weight-strong); font-variant-numeric: tabular-nums; color: var(--k-accent); }
  @media (min-width: 900px) {
    .home-privacy { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: var(--k-space-7); }
    .home-pin { position: sticky; top: calc(var(--k-space-9) + var(--k-space-5)); }
    .home-pin h2 { font-size: var(--k-type-scale-4); margin-top: 0; }
    .home-points { gap: var(--k-space-5); }
    .home-points .k-card { min-height: 200px; align-content: center; padding: var(--k-space-6); }
  }
  @media (prefers-reduced-motion: reduce) { .home-mark path { animation: none; stroke-dashoffset: 0; } .home-plane, .home-stage { animation: none; transform: none; transition: none; } }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) { .home-search { background: var(--k-surface); -webkit-backdrop-filter: none; backdrop-filter: none; } }
</style>
<script>
  // The glass planes follow the pointer over the hero (skipped for reduced motion / touch).
  const hero = document.querySelector<HTMLElement>('[data-glow]');
  const stage = hero?.querySelector<HTMLElement>('.home-stage');
  if (hero && stage && !matchMedia('(prefers-reduced-motion: reduce)').matches && matchMedia('(hover: hover)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        stage.style.setProperty('--gx', String(((e.clientX - r.left) / r.width) * 100));
        stage.style.setProperty('--gy', String(((e.clientY - r.top) / r.height) * 100));
      });
    }, { passive: true });
  }
</script>
