---
import Base from '../layouts/Base.astro';
import ToolCard from './ToolCard.astro';
import { tools, universes, ui, byPriority, type Lang } from '../lib/data';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const groups = universes.map((u) => ({ u, items: tools.filter((x) => x.tool.universe === u.id).sort(byPriority) })).filter((g) => g.items.length);
---
<Base title={`${t.all} — Kortex`} description={t.sub} lang={lang} alt={{ fr: '/outils', en: '/en/tools' }}>
  <h1>{t.all}</h1>
  {groups.length === 0 && <p class="k-muted">{t.empty}</p>}
  {groups.map((g) => (
    <section>
      <h2>{g.u.name}</h2>
      <div class="grid">{g.items.map((x) => <ToolCard t={x} lang={lang} />)}</div>
    </section>
  ))}
</Base>
