---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/data';
const { lang } = Astro.props as { lang: Lang };
const T = {
  fr: {
    title: 'Télécharger Kortex', h1: 'Installer Kortex sur votre ordinateur',
    intro: 'Les outils fonctionnent aussi directement dans le navigateur. Installez-les pour les utiliser hors ligne, avec de vrais fichiers sur votre disque.',
    step1: '1. Installer la commande kortex', step2: '2. Installer les outils que vous voulez',
    mac: 'macOS ou Linux (Terminal)', win: 'Windows (PowerShell)', detected: 'Détecté pour votre système',
    step2text: 'Chaque outil est téléchargé, vérifié (signature Ed25519 et empreinte SHA-256) puis installé dans votre dossier personnel, sans droits administrateur.',
    manualTitle: 'Téléchargement direct : avertissements du système',
    manualIntro: 'Kortex n’achète pas de certificat de signature de code : c’est ce qui permet de rester gratuit. Votre système peut donc afficher un avertissement si vous ouvrez un fichier téléchargé depuis un navigateur. L’installation par la commande ci-dessus ne les déclenche pas.',
    winH: 'Windows (SmartScreen)', winT: 'Cliquez sur « Informations complémentaires », puis « Exécuter quand même ».',
    macH: 'macOS (Gatekeeper)', macT: 'Clic droit sur l’application, « Ouvrir », puis confirmez. Une seule fois suffit.',
    linH: 'Linux', linT: 'Rendez le fichier exécutable : chmod +x kortex-… puis lancez-le.',
    verifyTitle: 'Vérifier l’installation', verifyT: 'La commande suivante contrôle le dossier, chaque outil installé (empreinte du binaire), la signature du catalogue et votre compte.',
    removeTitle: 'Désinstaller', removeT: 'Un outil : kortex remove <outil>. Tout Kortex : supprimez le dossier ~/.kortex (et la ligne PATH ajoutée à votre profil).',
    commands: 'Commandes utiles',
  },
  en: {
    title: 'Download Kortex', h1: 'Install Kortex on your computer',
    intro: 'Tools also work right in the browser. Install them to use them offline, with real files on your disk.',
    step1: '1. Install the kortex command', step2: '2. Install the tools you want',
    mac: 'macOS or Linux (Terminal)', win: 'Windows (PowerShell)', detected: 'Detected for your system',
    step2text: 'Each tool is downloaded, verified (Ed25519 signature and SHA-256 checksum) and installed in your home folder, with no administrator rights.',
    manualTitle: 'Direct download: system warnings',
    manualIntro: 'Kortex does not buy a code-signing certificate: that is what keeps it free. Your system may therefore show a warning if you open a file downloaded through a browser. Installing with the command above does not trigger them.',
    winH: 'Windows (SmartScreen)', winT: 'Click “More info”, then “Run anyway”.',
    macH: 'macOS (Gatekeeper)', macT: 'Right-click the app, choose “Open”, then confirm. Once is enough.',
    linH: 'Linux', linT: 'Make the file executable: chmod +x kortex-… then run it.',
    verifyTitle: 'Check the installation', verifyT: 'This command checks the folder, every installed tool (binary checksum), the catalogue signature and your account.',
    removeTitle: 'Uninstall', removeT: 'One tool: kortex remove <tool>. All of Kortex: delete the ~/.kortex folder (and the PATH line added to your profile).',
    commands: 'Useful commands',
  },
}[lang];
const unix = 'curl -fsSL https://kortex.site/install.sh | sh';
const win = 'irm https://kortex.site/install.ps1 | iex';
---
<Base title={`${T.title} — Kortex`} description={T.intro} lang={lang} alt={{ fr: '/telecharger', en: '/en/download' }}>
  <header class="page-head">
    <h1>{T.h1}</h1>
    <p class="lead">{T.intro}</p>
  </header>

  <ol class="dl-steps">
    <li class="dl-step">
      <h2>{T.step1}</h2>
      <div class="dl-grid">
        <section class="dl-os" data-os="unix">
          <div class="dl-os-head"><h3>{T.mac}</h3><span class="badge" data-tone="success">{T.detected}</span></div>
          <pre class="dl-cmd" tabindex="0"><code>{unix}</code></pre>
          <button class="k-btn" data-variant="ghost" type="button" data-copy={unix}>Copier / Copy</button>
        </section>
        <section class="dl-os" data-os="win">
          <div class="dl-os-head"><h3>{T.win}</h3><span class="badge" data-tone="success">{T.detected}</span></div>
          <pre class="dl-cmd" tabindex="0"><code>{win}</code></pre>
          <button class="k-btn" data-variant="ghost" type="button" data-copy={win}>Copier / Copy</button>
        </section>
      </div>
    </li>
    <li class="dl-step">
      <h2>{T.step2}</h2>
      <p class="k-muted">{T.step2text}</p>
      <pre class="dl-cmd" tabindex="0"><code>kortex available
kortex install secure.password-generator
kortex install --all</code></pre>
    </li>
  </ol>

  <div class="dl-more">
    <div class="dl-main">
      <section>
        <h2>{T.commands}</h2>
        <pre class="dl-cmd" tabindex="0"><code>kortex installed          kortex update --all
kortex update --self      kortex open &lt;tool&gt;
kortex login              kortex doctor</code></pre>
      </section>
      <section>
        <h2>{T.verifyTitle}</h2>
        <p class="k-muted">{T.verifyT}</p>
        <pre class="dl-cmd" tabindex="0"><code>kortex doctor</code></pre>
      </section>
      <section>
        <h2>{T.removeTitle}</h2>
        <p class="k-muted">{T.removeT}</p>
      </section>
    </div>
    <aside class="dl-aside">
      <h2>{T.manualTitle}</h2>
      <p class="k-muted">{T.manualIntro}</p>
      <ul class="dl-warn">
        <li><strong>{T.winH}</strong><p class="k-muted">{T.winT}</p></li>
        <li><strong>{T.macH}</strong><p class="k-muted">{T.macT}</p></li>
        <li><strong>{T.linH}</strong><p class="k-muted">{T.linT}</p></li>
      </ul>
    </aside>
  </div>
</Base>
<style is:global>
  .dl-steps { list-style: none; margin: 0; padding: 0; counter-reset: dl; display: grid; gap: var(--k-space-7); }
  .dl-step { counter-increment: dl; display: grid; gap: var(--k-space-4); padding-left: var(--k-space-8); position: relative; }
  .dl-step::before { content: ""; position: absolute; left: 12px; top: 9px; width: 12px; height: 12px; border-radius: var(--k-radius-round); background: var(--k-ink); outline: 4px solid var(--k-bg); }
  .dl-step:not(:last-child)::after { content: ""; position: absolute; left: 17.5px; top: 30px; bottom: calc(-1 * var(--k-space-6)); width: 1px; background: var(--k-border-strong); }
  .dl-step h2 { margin: var(--k-space-1) 0 0; font-size: var(--k-type-scale-1); }
  .dl-step p { margin: 0; max-width: 64ch; line-height: 1.6; }
  .dl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--k-space-4); }
  .dl-os { display: grid; gap: var(--k-space-3); align-content: start; padding: var(--k-space-5); border: 1px solid var(--k-border); border-radius: var(--k-radius-card); background: var(--k-surface); transition: border-color var(--k-motion-base) var(--k-motion-ease); }
  .dl-os-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--k-space-3); min-height: 28px; }
  .dl-os h3 { margin: 0; font-size: var(--k-type-scale-0); }
  .dl-os .badge { display: none; }
  .dl-os[data-detected] { border-color: var(--k-accent); box-shadow: var(--k-shadow-ring); }
  .dl-os[data-detected] .badge { display: inline-flex; }
  .dl-os .k-btn { justify-self: start; }
  .dl-cmd { margin: 0; padding: var(--k-space-4); border-radius: var(--k-radius-field); background: var(--k-surface-2); overflow-x: auto; font-family: var(--k-type-mono); font-size: 0.875rem; line-height: 1.7; }
  .dl-cmd:focus-visible { outline-offset: 2px; }
  .dl-more { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: var(--k-space-8); margin-top: var(--k-space-9); padding-top: var(--k-space-7); border-top: 1px solid var(--k-border); align-items: start; }
  .dl-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--k-space-7); min-width: 0; }
  .dl-cmd code { font-size: inherit; }
  .dl-main h2, .dl-aside h2 { margin: 0 0 var(--k-space-3); font-size: var(--k-type-scale-1); }
  .dl-main p, .dl-aside > p { margin: 0 0 var(--k-space-4); line-height: 1.6; }
  .dl-aside { padding: var(--k-space-6); border-radius: var(--k-radius-card); background: var(--k-surface-2); }
  .dl-warn { list-style: none; margin: 0; padding: 0; display: grid; }
  .dl-warn li { padding: var(--k-space-4) 0; border-top: 1px solid var(--k-border); }
  .dl-warn p { margin: var(--k-space-1) 0 0; font-size: var(--k-type-scale-sm); line-height: 1.6; }
  @media (max-width: 899px) { .dl-more { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 599px) { .dl-step { padding-left: 0; } .dl-step::before, .dl-step::after { display: none; } .dl-aside { padding: var(--k-space-5); } }
</style>
<script>
  // Highlight the command for the visitor's system and make the buttons copy it.
  const ua = navigator.userAgent;
  const os = /Windows/.test(ua) ? 'win' : /Mac|Linux|X11/.test(ua) ? 'unix' : null;
  if (os) document.querySelector(`[data-os="${os}"]`)?.setAttribute('data-detected', '');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = '✓'; } catch { /* selection is still possible by hand */ }
    }),
  );
</script>
