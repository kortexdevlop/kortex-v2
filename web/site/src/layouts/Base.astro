---
import { prefix, type Lang } from '../lib/data';
import SiteSearch from '../components/SiteSearch.astro';
interface Props { title: string; description: string; lang: Lang; alt?: { fr: string; en: string }; noindex?: boolean; jsonLd?: object[]; ogImage?: string }
const { title, description, lang, alt, noindex = false, jsonLd = [], ogImage } = Astro.props;
const og = ogImage ?? `/og/${lang}/home.png`;
const site = Astro.site?.origin ?? 'https://kortex.site';
const nav = lang === 'fr'
  ? { apps: 'Applications', appsHref: '/applications', tools: 'Outils', all: '/outils', other: 'EN', account: 'Compte', accountHref: '/compte', dl: 'Télécharger', dlHref: '/telecharger' }
  : { apps: 'Apps', appsHref: '/en/apps', tools: 'Tools', all: '/en/tools', other: 'FR', account: 'Account', accountHref: '/en/account', dl: 'Download', dlHref: '/en/download' };
const otherHref = alt ? (lang === 'fr' ? alt.en : alt.fr) : (lang === 'fr' ? '/en' : '/');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
    {alt && <link rel="alternate" hreflang="fr" href={`${site}${alt.fr}`} />}
    {alt && <link rel="alternate" hreflang="en" href={`${site}${alt.en}`} />}
    {alt && <link rel="alternate" hreflang="x-default" href={`${site}${alt.fr}`} />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/kortex-192.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kortex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={`${site}${og}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/kortex.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/kortex.css" />
    <script is:inline>
      try { localStorage.removeItem('kortex-desk-v1'); localStorage.removeItem('kortex-hub-v1'); const t = localStorage.getItem('k-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href={prefix(lang) || '/'} aria-label="Kortex">
        <svg width="28" height="28" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 13V51M22 33C30 33 37 28 43 15C46 25 40 32 33 36C41 38 46 44 47 51" /></svg>
        <span>Kortex</span>
      </a>
      <nav>
        <SiteSearch lang={lang} />
        <select class="mode-select" data-mode-select aria-label={lang === 'fr' ? 'Mode (Simple, Medium, Pro)' : 'Mode (Simple, Medium, Pro)'}>
          <option value="simple">Simple</option><option value="medium" selected>Medium</option><option value="pro">Pro</option>
        </select>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label={lang === 'fr' ? 'Changer de thème' : 'Switch theme'}>◐</button>
        <a href={nav.all}>{nav.tools}</a>
        <a href={nav.appsHref}>{nav.apps}</a>
        <a href={nav.dlHref}>{nav.dl}</a>
        <a href={nav.accountHref}>{nav.account}</a>
        <a href={otherHref} hreflang={lang === 'fr' ? 'en' : 'fr'}>{nav.other}</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-foot k-muted">
      <span>© Kortex</span>
      <span>{lang === 'fr' ? 'Vos fichiers ne quittent jamais votre appareil.' : 'Your files never leave your device.'}</span>
      <nav class="foot-links">
        {lang === 'fr'
          ? <><a href="/confidentialite">Confidentialité</a><a href="/conditions">Conditions</a><a href="/mentions-legales">Mentions légales</a></>
          : <><a href="/en/privacy">Privacy</a><a href="/en/terms">Terms</a><a href="/en/legal-notice">Legal notice</a></>}
      </nav>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const order = ['auto', 'light', 'dark'];
        const cur = () => { try { return localStorage.getItem('k-theme') || 'auto'; } catch { return 'auto'; } };
        const label = (m) => ({ auto: '◐', light: '☀', dark: '☾' })[m];
        const apply = (m) => {
          if (m === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = m;
          try { m === 'auto' ? localStorage.removeItem('k-theme') : localStorage.setItem('k-theme', m); } catch {}
          btn.textContent = label(m);
          window.dispatchEvent(new Event('kortex:theme'));
        };
        btn.textContent = label(cur());
        btn.addEventListener('click', () => apply(order[(order.indexOf(cur()) + 1) % order.length]));
      })();
    </script>
    <script is:inline>
      (() => {
        const sel = document.querySelector('[data-mode-select]');
        if (!sel) return;
        try { sel.value = localStorage.getItem('k-mode') || 'medium'; } catch {}
        sel.addEventListener('change', () => {
          try { localStorage.setItem('k-mode', sel.value); } catch {}
          window.dispatchEvent(new Event('kortex:mode'));
        });
      })();
    </script>
    <script is:inline>if ('serviceWorker' in navigator && location.hostname !== 'localhost') navigator.serviceWorker.register('/sw.js');</script>
  </body>
</html>
<style is:global>
  [hidden] { display: none !important; }
  main { max-width: 1080px; margin: 0 auto; padding: var(--k-space-8) var(--k-space-4) var(--k-space-9); }
  .site-head { position: sticky; top: var(--k-space-3); z-index: 10; display: flex; justify-content: space-between; align-items: center; max-width: 1080px; margin: var(--k-space-3) auto 0; padding: var(--k-space-2) var(--k-space-4); border: 1px solid var(--k-border); border-radius: var(--k-radius-panel); background: var(--k-overlay); backdrop-filter: blur(20px) saturate(1.4); box-shadow: var(--k-shadow-2); }
  .site-head a { color: inherit; text-decoration: none; }
  .brand { display: inline-flex; align-items: center; gap: var(--k-space-2); font-weight: 650; letter-spacing: -0.02em; }
  .site-head { flex-wrap: wrap; row-gap: var(--k-space-2); }
  .site-head nav { display: flex; flex-wrap: wrap; gap: var(--k-space-3) var(--k-space-4); align-items: center; justify-content: flex-end; }
  @media (max-width: 900px) { .site-head { border-radius: var(--k-radius-card); } .site-head nav { flex: 1 1 100%; justify-content: flex-start; } }
  .site-foot { display: flex; justify-content: space-between; gap: var(--k-space-4); flex-wrap: wrap; max-width: 1080px; margin: 0 auto; padding: var(--k-space-6) var(--k-space-4); }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); margin: 0 0 var(--k-space-4); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--k-space-4); }
  .tool-card { display: grid; gap: var(--k-space-2); color: inherit; text-decoration: none; }
  .tool-icon { display: block; border-radius: 22%; }
  .tool-card svg, .glyph svg { width: 32px; height: 32px; color: var(--k-accent); }
  .badges { display: flex; flex-wrap: wrap; gap: var(--k-space-2); margin: var(--k-space-4) 0; }
  .badge { padding: var(--k-space-1) var(--k-space-3); border-radius: 999px; background: var(--k-surface-2); font-size: 0.85rem; color: var(--k-text-2); }
  .prose h2 { margin-top: var(--k-space-7); }
  .mode-select { min-height: 36px; padding: 0 var(--k-space-3); border: 1px solid var(--k-border); border-radius: 999px; background: var(--k-surface); color: var(--k-text-2); font: inherit; cursor: pointer; }
  .theme-toggle { min-width: 36px; min-height: 36px; border: 1px solid var(--k-border); border-radius: 999px; background: var(--k-surface); color: var(--k-text-2); font: inherit; cursor: pointer; }
  .theme-toggle:hover { color: var(--k-text); box-shadow: var(--k-shadow-1); }
  .foot-links { display: flex; gap: var(--k-space-4); flex-wrap: wrap; } .foot-links a { color: inherit; }
  details { padding: var(--k-space-3) 0; border-bottom: 1px solid var(--k-border); }
  summary { cursor: pointer; font-weight: 600; }
</style>
