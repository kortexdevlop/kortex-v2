---
import { prefix, type Lang } from '../lib/data';
import SiteSearch from '../components/SiteSearch.astro';
interface Props { title: string; description: string; lang: Lang; alt?: { fr: string; en: string }; noindex?: boolean; jsonLd?: object[]; ogImage?: string; wide?: boolean }
const { title, description, lang, alt, noindex = false, jsonLd = [], ogImage, wide = false } = Astro.props;
const og = ogImage ?? `/og/${lang}/home.png`;
const site = Astro.site?.origin ?? 'https://kortex.site';
const fr = lang === 'fr';
const nav = fr
  ? { apps: 'Applications', appsHref: '/applications', tools: 'Outils', all: '/outils', other: 'EN', account: 'Compte', accountHref: '/compte', dl: 'Télécharger', dlHref: '/telecharger' }
  : { apps: 'Apps', appsHref: '/en/apps', tools: 'Tools', all: '/en/tools', other: 'FR', account: 'Account', accountHref: '/en/account', dl: 'Download', dlHref: '/en/download' };
const T = fr
  ? { main: 'Navigation principale', settings: 'Réglages d’affichage', mode: 'Mode des outils', theme: 'Thème', lang: 'Langue', english: 'English', tagline: 'Des outils gratuits qui s’exécutent sur votre appareil. Vos fichiers ne le quittent jamais.', product: 'Produit', legal: 'Informations' }
  : { main: 'Main navigation', settings: 'Display settings', mode: 'Tool mode', theme: 'Theme', lang: 'Language', english: 'Français', tagline: 'Free tools that run on your device. Your files never leave it.', product: 'Product', legal: 'Information' };
const otherHref = alt ? (fr ? alt.en : alt.fr) : (fr ? '/en' : '/');
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (here === href || here.startsWith(`${href}/`) ? 'page' : undefined);
const links = [
  { href: nav.all, label: nav.tools, icon: 'tools' },
  { href: nav.appsHref, label: nav.apps, icon: 'apps' },
  { href: nav.dlHref, label: nav.dl, icon: 'download' },
  { href: nav.accountHref, label: nav.account, icon: 'account' },
];
const legal = fr
  ? [['/confidentialite', 'Confidentialité'], ['/conditions', 'Conditions'], ['/mentions-legales', 'Mentions légales']]
  : [['/en/privacy', 'Privacy'], ['/en/terms', 'Terms'], ['/en/legal-notice', 'Legal notice']];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
    {alt && <link rel="alternate" hreflang="fr" href={`${site}${alt.fr}`} />}
    {alt && <link rel="alternate" hreflang="en" href={`${site}${alt.en}`} />}
    {alt && <link rel="alternate" hreflang="x-default" href={`${site}${alt.fr}`} />}
    <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/kortex-192.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kortex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={fr ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={`${site}${og}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/icons/kortex.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/kortex.css" />
    <script is:inline>
      try { localStorage.removeItem('kortex-desk-v1'); localStorage.removeItem('kortex-hub-v1'); const t = localStorage.getItem('k-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <div class="k-ambient" aria-hidden="true"></div>
    <header class="site-head">
      <div class="site-bar">
        <a class="brand" href={prefix(lang) || '/'} aria-label="Kortex">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 13V51M22 33C30 33 37 28 43 15C46 25 40 32 33 36C41 38 46 44 47 51" /></svg>
          </span>
          <span class="brand-name">Kortex</span>
        </a>
        <nav class="site-links" aria-label={T.main}>
          {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
        </nav>
        <div class="site-tools">
          <SiteSearch lang={lang} />
          <button class="site-icon settings-toggle" type="button" aria-expanded="false" aria-controls="site-settings" aria-label={T.settings} data-settings-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" /><circle cx="16" cy="7" r="2" /><circle cx="8" cy="17" r="2" /></svg>
          </button>
          <div class="site-settings" id="site-settings" data-settings>
            <div class="setting">
              <span class="setting-label" id="mode-label">{T.mode}</span>
              <div class="k-segmented mode-seg" role="radiogroup" aria-labelledby="mode-label" data-mode-group>
                <button class="k-segment" type="button" role="radio" aria-checked="false" data-mode="simple">Simple</button>
                <button class="k-segment" type="button" role="radio" aria-checked="true" data-mode="medium">Medium</button>
                <button class="k-segment" type="button" role="radio" aria-checked="false" data-mode="pro">Pro</button>
              </div>
            </div>
            <div class="setting setting-row">
              <span class="setting-label">{T.theme}</span>
              <button class="site-icon theme-toggle" type="button" data-theme-toggle data-state="auto"
                data-labels={JSON.stringify(fr ? { auto: 'Thème : automatique', light: 'Thème : clair', dark: 'Thème : sombre' } : { auto: 'Theme: automatic', light: 'Theme: light', dark: 'Theme: dark' })}
                aria-label={fr ? 'Thème : automatique' : 'Theme: automatic'}>
                <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" /></svg>
                <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
                <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" /></svg>
              </button>
              <a class="site-icon lang-switch" href={otherHref} hreflang={fr ? 'en' : 'fr'} lang={fr ? 'en' : 'fr'} title={T.english} aria-label={T.english}>{nav.other}</a>
            </div>
          </div>
        </div>
      </div>
    </header>
    <nav class="tab-bar" aria-label={T.main}>
      {links.map((l) => (
        <a href={l.href} aria-current={current(l.href)}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            {l.icon === 'tools' && <><rect x="4" y="4" width="6.5" height="6.5" rx="2" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="2" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="2" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="3.25" /></>}
            {l.icon === 'apps' && <><rect x="3.5" y="5" width="17" height="14" rx="3" /><path d="M3.5 9.5h17M7 7.2h.01M9.5 7.2h.01" /></>}
            {l.icon === 'download' && <><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5" /><path d="M5 19.5h14" /></>}
            {l.icon === 'account' && <><circle cx="12" cy="9" r="3.5" /><path d="M5.5 19.5c1.3-3 3.6-4.5 6.5-4.5s5.2 1.5 6.5 4.5" /></>}
          </svg>
          <span>{l.label}</span>
        </a>
      ))}
    </nav>
    <main class:list={[{ 'main-wide': wide }]}><slot /></main>
    <footer class="site-foot">
      <div class="foot-inner">
        <div class="foot-brand">
          <a class="brand" href={prefix(lang) || '/'} aria-label="Kortex">
            <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 13V51M22 33C30 33 37 28 43 15C46 25 40 32 33 36C41 38 46 44 47 51" /></svg></span>
            <span class="brand-name">Kortex</span>
          </a>
          <p class="k-muted">{T.tagline}</p>
        </div>
        <nav class="foot-col" aria-label={T.product}>
          <p class="foot-title">{T.product}</p>
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav class="foot-col" aria-label={T.legal}>
          <p class="foot-title">{T.legal}</p>
          {legal.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
      <p class="foot-copy k-muted">© Kortex</p>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        const order = ['auto', 'light', 'dark'];
        const labels = JSON.parse(btn.dataset.labels || '{}');
        const cur = () => { try { return localStorage.getItem('k-theme') || 'auto'; } catch { return 'auto'; } };
        const show = (m) => { btn.dataset.state = m; if (labels[m]) btn.setAttribute('aria-label', labels[m]); };
        const apply = (m) => {
          if (m === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = m;
          try { m === 'auto' ? localStorage.removeItem('k-theme') : localStorage.setItem('k-theme', m); } catch {}
          show(m);
          window.dispatchEvent(new Event('kortex:theme'));
        };
        show(cur());
        btn.addEventListener('click', () => apply(order[(order.indexOf(cur()) + 1) % order.length]));
      })();
    </script>
    <script is:inline>
      (() => {
        // Simple / Medium / Pro: a radio group; same storage key and event as before.
        const group = document.querySelector('[data-mode-group]');
        if (!group) return;
        const items = [...group.querySelectorAll('[data-mode]')];
        const read = () => { try { return localStorage.getItem('k-mode') || 'medium'; } catch { return 'medium'; } };
        const paint = (m) => items.forEach((b) => { const on = b.dataset.mode === m; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
        const pick = (m) => {
          try { localStorage.setItem('k-mode', m); } catch {}
          paint(m);
          window.dispatchEvent(new Event('kortex:mode'));
        };
        paint(read());
        items.forEach((b, i) => {
          b.addEventListener('click', () => pick(b.dataset.mode));
          b.addEventListener('keydown', (e) => {
            const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
            if (!step) return;
            e.preventDefault();
            const next = items[(i + step + items.length) % items.length];
            pick(next.dataset.mode); next.focus();
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        // Compact screens: the display settings live in a popover behind one button.
        const toggle = document.querySelector('[data-settings-toggle]');
        const panel = document.querySelector('[data-settings]');
        if (!toggle || !panel) return;
        const set = (open) => { toggle.setAttribute('aria-expanded', String(open)); panel.toggleAttribute('data-open', open); };
        toggle.addEventListener('click', (e) => { e.stopPropagation(); set(toggle.getAttribute('aria-expanded') !== 'true'); });
        addEventListener('click', (e) => { if (panel.hasAttribute('data-open') && !panel.contains(e.target)) set(false); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.hasAttribute('data-open')) { set(false); toggle.focus(); } });
        // The bar gains its hairline once the page scrolls.
        const head = document.querySelector('.site-head');
        const mark = () => head && head.toggleAttribute('data-scrolled', scrollY > 4);
        addEventListener('scroll', mark, { passive: true }); mark();
      })();
    </script>
    <script is:inline>
      (() => {
        // Reveal fallback where scroll-driven animations are missing.
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!still && !CSS.supports('animation-timeline: view()') && 'IntersectionObserver' in window) {
          document.documentElement.classList.add('k-io');
          const io = new IntersectionObserver((es) => es.forEach((x) => x.isIntersecting && (x.target.classList.add('is-in'), io.unobserve(x.target))), { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('.reveal').forEach((n) => io.observe(n));
        }
      })();
    </script>
    <script is:inline>if ('serviceWorker' in navigator && location.hostname !== 'localhost') navigator.serviceWorker.register('/sw.js');</script>
  </body>
</html>
<style is:global>
  @view-transition { navigation: auto; }
  [hidden] { display: none !important; }
  body { display: flex; flex-direction: column; }
  :root { --site-max: 1200px; --site-gutter: max(var(--k-space-5), env(safe-area-inset-left)); --site-bar: 60px; }
  main { flex: 1; width: 100%; max-width: calc(var(--site-max) + 2 * var(--k-space-5)); min-height: 70dvh; margin: 0 auto; padding: var(--k-space-7) var(--site-gutter) var(--k-space-9); }
  main > h1, main > section > h1 { font-size: clamp(2.25rem, 4.6vw, var(--k-type-scale-5)); margin: 0 0 var(--k-space-3); }

  /* ── Top bar: one thin pane of glass, full width, content aligned to the page grid ── */
  .site-head { position: sticky; top: 0; z-index: 30; padding-top: env(safe-area-inset-top); view-transition-name: site-head;
    background: var(--k-glass); border-bottom: 1px solid transparent; transition: border-color var(--k-motion-base) var(--k-motion-ease);
    -webkit-backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); }
  .site-head[data-scrolled] { border-bottom-color: var(--k-border); }
  .site-bar { display: flex; align-items: center; gap: var(--k-space-4); max-width: calc(var(--site-max) + 2 * var(--k-space-5)); height: var(--site-bar); margin: 0 auto; padding: 0 var(--site-gutter); }
  .site-head a, .site-foot a { color: inherit; text-decoration: none; }
  .brand { display: inline-flex; align-items: center; gap: var(--k-space-2); min-height: 44px; font-family: var(--k-type-display); font-weight: var(--k-type-weight-strong); font-size: 1.0625rem; letter-spacing: var(--k-type-tracking-tight); }
  .brand-mark { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: var(--k-radius-control); background: var(--k-ink); color: var(--k-ink-text); }
  .brand-mark svg { width: 18px; height: 18px; }
  .site-links { display: flex; align-items: center; gap: var(--k-space-1); margin-left: var(--k-space-4); }
  .site-links a { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--k-space-3); color: var(--k-text-2); font-size: 0.9375rem; font-weight: var(--k-type-weight-medium);
    transition: color var(--k-motion-base) var(--k-motion-ease); }
  .site-links a:hover { color: var(--k-text); }
  .site-links a[aria-current="page"] { color: var(--k-text); }
  .site-links a::after { content: ""; position: absolute; left: var(--k-space-3); right: var(--k-space-3); bottom: 8px; height: 2px; border-radius: var(--k-radius-pill); background: var(--k-ink); transform: scaleX(0); transition: transform var(--k-motion-slow) var(--k-motion-out); }
  .site-links a[aria-current="page"]::after { transform: scaleX(1); }
  .site-tools { position: relative; display: flex; align-items: center; gap: var(--k-space-2); margin-left: auto; }
  .site-icon { display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--k-radius-pill); background: transparent; color: var(--k-text-2);
    font: inherit; font-size: var(--k-type-scale-sm); font-weight: var(--k-type-weight-strong); cursor: pointer; transition: background-color var(--k-motion-base) var(--k-motion-ease), color var(--k-motion-base) var(--k-motion-ease); }
  .site-icon:hover, .site-icon[aria-expanded="true"] { background: var(--k-surface-2); color: var(--k-text); }
  .site-icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .theme-toggle svg { display: none; }
  .theme-toggle[data-state="auto"] .i-auto, .theme-toggle[data-state="light"] .i-light, .theme-toggle[data-state="dark"] .i-dark { display: block; }
  .site-settings { display: flex; align-items: center; gap: var(--k-space-2); }
  .setting { display: flex; align-items: center; gap: var(--k-space-1); }
  .setting-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .settings-toggle { display: none; }
  .mode-seg .k-segment { padding-inline: var(--k-space-3); }

  /* Below 1100 px the display settings fold into a popover. */
  @media (max-width: 1099px) {
    .settings-toggle { display: inline-grid; }
    .site-settings { position: absolute; top: calc(100% + var(--k-space-2)); right: 0; z-index: 40; display: grid; gap: var(--k-space-4); width: 296px; padding: var(--k-space-4);
      border: 1px solid var(--k-glass-edge); border-radius: var(--k-radius-sheet); background: var(--k-glass-strong); box-shadow: var(--k-shadow-inset), var(--k-shadow-4);
      -webkit-backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate));
      opacity: 0; visibility: hidden; transform: translateY(-4px) scale(0.98); transform-origin: top right;
      transition: opacity var(--k-motion-base) var(--k-motion-ease), transform var(--k-motion-slow) var(--k-motion-out), visibility 0s linear var(--k-motion-slow); }
    .site-settings[data-open] { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
    .setting { display: grid; gap: var(--k-space-2); }
    .setting-label { position: static; width: auto; height: auto; clip-path: none; font-size: var(--k-type-scale-sm); font-weight: var(--k-type-weight-medium); color: var(--k-text-2); }
    .setting-row { display: flex; align-items: center; justify-content: space-between; }
    .setting-row .setting-label { margin-right: auto; }
    .mode-seg { display: flex; }
    .mode-seg .k-segment { flex: 1; }
  }

  /* ── Bottom tab bar (phones): the four destinations, thumb-reachable ── */
  .tab-bar { display: none; }
  @media (max-width: 719px) {
    :root { --site-gutter: max(var(--k-space-4), env(safe-area-inset-left)); --site-bar: 56px; }
    .site-links { display: none; }
    .tab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: grid; grid-template-columns: repeat(4, 1fr); padding: var(--k-space-1) var(--k-space-2) max(var(--k-space-1), env(safe-area-inset-bottom));
      background: var(--k-glass); border-top: 1px solid var(--k-border);
      -webkit-backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); backdrop-filter: blur(var(--k-glass-blur-lg)) saturate(var(--k-glass-saturate)); }
    .tab-bar a { display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 52px; color: var(--k-text-2); text-decoration: none; font-size: var(--k-type-scale-sm); font-weight: var(--k-type-weight-medium); }
    .tab-bar a[aria-current="page"] { color: var(--k-text); }
    .tab-bar svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--k-motion-fast) var(--k-motion-ease); }
    .tab-bar a:active svg { transform: scale(0.9); }
    .tab-bar a[aria-current="page"] svg { stroke-width: 2; }
    body { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
    main { padding-top: var(--k-space-6); }
  }

  /* ── Footer: quiet, structured, no glass ── */
  .site-foot { width: 100%; max-width: calc(var(--site-max) + 2 * var(--k-space-5)); margin: 0 auto; padding: var(--k-space-7) var(--site-gutter) max(var(--k-space-6), env(safe-area-inset-bottom)); border-top: 1px solid var(--k-border); font-size: var(--k-type-scale-sm); }
  .foot-inner { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: var(--k-space-6); }
  .foot-brand p { max-width: 34ch; margin: var(--k-space-3) 0 0; line-height: 1.6; }
  .foot-col { display: grid; align-content: start; }
  .foot-title { margin: 0 0 var(--k-space-1); font-weight: var(--k-type-weight-strong); }
  .foot-col a { display: inline-flex; align-items: center; min-height: 44px; color: var(--k-text-2); transition: color var(--k-motion-base) var(--k-motion-ease); }
  .foot-col a:hover { color: var(--k-text); }
  .foot-copy { margin: var(--k-space-6) 0 0; }
  @media (max-width: 719px) { .foot-inner { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }

  /* ── Shared page vocabulary ── */
  .page-head { display: grid; gap: var(--k-space-3); padding: var(--k-space-6) 0 var(--k-space-7); }
  .page-head h1 { margin: 0; font-size: clamp(2.25rem, 4.6vw, var(--k-type-scale-5)); max-width: 18ch; }
  .page-head .lead, .lead { margin: 0; max-width: 60ch; color: var(--k-text-2); font-size: var(--k-type-scale-1); line-height: 1.5; }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: var(--k-space-2); font-size: var(--k-type-scale-sm); color: var(--k-text-2); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--k-text-2); text-decoration: none; }
  .crumbs a:hover { color: var(--k-text); }
  .crumbs span[aria-hidden] { opacity: 0.6; }
  .section { margin-top: var(--k-space-9); }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: var(--k-space-3) var(--k-space-5); flex-wrap: wrap; margin-bottom: var(--k-space-5); }
