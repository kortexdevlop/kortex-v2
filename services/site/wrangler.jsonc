{
  "name": "kortex-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "kortex.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../dist/publish/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
