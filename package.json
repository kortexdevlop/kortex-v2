{
  "name": "kortex",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "site:dev": "pnpm --filter @kortex/site dev",
    "site:build": "pnpm --filter @kortex/site build",
    "deploy": "pnpm site:build && node scripts/prepare-publish.mjs && node scripts/publish.mjs",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:engines": "node tests/e2e/engines.mjs",
    "e2e:mind": "node tests/e2e/mind.mjs",
    "e2e:pwa": "node tests/e2e/pwa.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
